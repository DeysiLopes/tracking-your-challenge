# Copie para .env.local (não commita) ou configure como env vars no deploy.

# Base path do app — '/' em Cloudflare Pages / domínio próprio.
VITE_BASE_PATH=/

# OAuth Client ID do Google (opcional — só pra sync com Drive).
# Crie em console.cloud.google.com → APIs e Serviços → Credenciais
# → OAuth Client ID (tipo Web) → adicione a origem do app nas
# "Origens JavaScript autorizadas". Sem isso o app funciona 100% offline.
VITE_GOOGLE_CLIENT_ID=
